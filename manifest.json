{
  "manifest_version": 3,
  "name": "Quick Explain & Translate",
  "version": "1.0.0",
  "description": "Select text on any page and quickly ask AI (Moonshot/Kimi or DeepSeek) to explain, translate, or summarize.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.moonshot.cn/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
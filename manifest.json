{
  "manifest_version": 3,
  "name": "Kimi Quick Explain & Translate",
  "version": "1.0.0",
  "description": "Select text on any page and quickly ask Kimi AI to explain or translate it to Chinese.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.moonshot.cn/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}